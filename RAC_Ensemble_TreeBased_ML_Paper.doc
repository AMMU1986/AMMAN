\pard\intbl\qc\fs18 {\fs18 CART}\cell
\pard\intbl\qc\fs18 {\fs18 Single tree}\cell
\pard\intbl\qc\fs18 {\fs18 0.861}\cell
\pard\intbl\qc\fs18 {\fs18 6.33}\cell
\pard\intbl\qc\fs18 {\fs18 4.92}\cell
