<h2>Source Code</h2>
<p class="cap"><b>StudentApp.html</b></p><pre>&lt;!DOCTYPE html&gt;
&lt;!--
  Web Development :: Graded Assignment (Weeks 1-6)
  Question 2  -  Student ID Card Application Form
  Prepared by : AMMAN JAKHAR
  UID         : 2025eb01187
  Each input runs its checker on the onfocusout event; submit builds an
  Applicant object, logs it, and parks it in a cookie. A second panel then
  reads that cookie back by mobile number.
--&gt;
&lt;html lang=&quot;en&quot;&gt;

&lt;head&gt;
  &lt;meta charset=&quot;UTF-8&quot; /&gt;
  &lt;meta name=&quot;viewport&quot; content=&quot;width=device-width, initial-scale=1&quot; /&gt;
  &lt;title&gt;2025eb01187&lt;/title&gt;

  &lt;style&gt;
    body {
      margin: 0;
      padding: 36px 14px;
      font-family: &quot;Trebuchet MS&quot;, &quot;Segoe UI&quot;, system-ui, sans-serif;
      color: #13343b;
      background: #eef3f2;
      display: flex;
      justify-content: center;
    }

    .panel {
      width: 430px;
      max-width: 100%;
      padding: 26px 28px 30px;
      background: #fff;
      border-top: 6px solid #e0a800;
      border-radius: 6px;
      box-shadow: 0 8px 22px rgba(19, 52, 59, 0.18);
    }

    .panel__title {
      margin: 0 0 4px;
      font-size: 21px;
    }

    .panel__hint {
      margin: 0 0 10px;
      font-size: 12px;
      color: #5c7177;
    }

    .field {
      border: 0;
      margin: 16px 0 0;
      padding: 0;
    }

    label {
      display: block;
      margin-bottom: 5px;
      font-size: 13px;
      font-weight: 700;
      letter-spacing: 0.3px;
    }

    input {
      width: 100%;
      padding: 10px 11px;
      font-size: 14px;
      color: #13343b;
      background: #fbfdfc;
      border: 1px solid #c3cdcb;
      border-radius: 4px;
      box-sizing: border-box;
    }

    input:focus {
      outline: 2px solid #e0a800;
      border-color: #e0a800;
    }

    input[readonly] {
      background: #eef1f0;
      color: #566;
    }

    .msg {
      display: block;
      min-height: 16px;
      margin-top: 4px;
      font-size: 12px;
      color: #b3261e;
    }

    .go {
      width: 100%;
      margin-top: 22px;
      padding: 12px;
      font-size: 15px;
      font-weight: 700;
      letter-spacing: 0.4px;
      color: #fff;
      background: #13343b;
      border: 0;
      border-radius: 4px;
      cursor: pointer;
    }

    .go:hover {
      background: #0c252b;
    }
  &lt;/style&gt;
&lt;/head&gt;

&lt;body&gt;

  &lt;!-- ===== Panel 1 : the application form ===== --&gt;
  &lt;section id=&quot;formPage&quot; class=&quot;panel&quot;&gt;
    &lt;h1 class=&quot;panel__title&quot;&gt;Student ID Card Application&lt;/h1&gt;
    &lt;p class=&quot;panel__hint&quot;&gt;Fields are checked as you leave each box.&lt;/p&gt;

    &lt;form id=&quot;appForm&quot; onsubmit=&quot;return onSubmit(event)&quot; novalidate&gt;

      &lt;fieldset class=&quot;field&quot;&gt;
        &lt;label for=&quot;name&quot;&gt;Full Name&lt;/label&gt;
        &lt;input id=&quot;name&quot; type=&quot;text&quot; autocomplete=&quot;off&quot; onfocusout=&quot;checkName()&quot; /&gt;
        &lt;small id=&quot;nameError&quot; class=&quot;msg&quot;&gt;&lt;/small&gt;
      &lt;/fieldset&gt;

      &lt;fieldset class=&quot;field&quot;&gt;
        &lt;label for=&quot;dob&quot;&gt;Date of Birth &lt;span style=&quot;font-weight:400&quot;&gt;(dd/mm/yyyy)&lt;/span&gt;&lt;/label&gt;
        &lt;input id=&quot;dob&quot; type=&quot;text&quot; autocomplete=&quot;off&quot; placeholder=&quot;dd/mm/yyyy&quot; onfocusout=&quot;checkDob()&quot; /&gt;
        &lt;small id=&quot;dobError&quot; class=&quot;msg&quot;&gt;&lt;/small&gt;
      &lt;/fieldset&gt;

      &lt;fieldset class=&quot;field&quot;&gt;
        &lt;label for=&quot;age&quot;&gt;Age&lt;/label&gt;
        &lt;input id=&quot;age&quot; type=&quot;text&quot; readonly placeholder=&quot;filled from DOB&quot; /&gt;
        &lt;small id=&quot;ageError&quot; class=&quot;msg&quot;&gt;&lt;/small&gt;
      &lt;/fieldset&gt;

      &lt;fieldset class=&quot;field&quot;&gt;
        &lt;label for=&quot;mobile&quot;&gt;Mobile Number&lt;/label&gt;
        &lt;input id=&quot;mobile&quot; type=&quot;text&quot; autocomplete=&quot;off&quot; onfocusout=&quot;checkMobile()&quot; /&gt;
        &lt;small id=&quot;mobileError&quot; class=&quot;msg&quot;&gt;&lt;/small&gt;
      &lt;/fieldset&gt;

      &lt;fieldset class=&quot;field&quot;&gt;
        &lt;label for=&quot;email&quot;&gt;Email ID&lt;/label&gt;
        &lt;input id=&quot;email&quot; type=&quot;text&quot; autocomplete=&quot;off&quot; onfocusout=&quot;checkEmail()&quot; /&gt;
        &lt;small id=&quot;emailError&quot; class=&quot;msg&quot;&gt;&lt;/small&gt;
      &lt;/fieldset&gt;

      &lt;button type=&quot;submit&quot; class=&quot;go&quot;&gt;Submit Application&lt;/button&gt;
    &lt;/form&gt;
  &lt;/section&gt;

  &lt;!-- ===== Panel 2 : read the saved cookie back ===== --&gt;
  &lt;section id=&quot;retrievePage&quot; class=&quot;panel&quot; style=&quot;display:none&quot;&gt;
    &lt;h1 class=&quot;panel__title&quot;&gt;Retrieve Saved Details&lt;/h1&gt;
    &lt;p class=&quot;panel__hint&quot;&gt;Type the mobile number you submitted.&lt;/p&gt;

    &lt;fieldset class=&quot;field&quot;&gt;
      &lt;label for=&quot;retrieveMobile&quot;&gt;Mobile Number&lt;/label&gt;
      &lt;input id=&quot;retrieveMobile&quot; type=&quot;text&quot; autocomplete=&quot;off&quot; /&gt;
    &lt;/fieldset&gt;

    &lt;button type=&quot;button&quot; class=&quot;go&quot; onclick=&quot;onRetrieve()&quot;&gt;Retrieve Cookie&lt;/button&gt;
  &lt;/section&gt;

  &lt;script src=&quot;StudentApp.js&quot;&gt;&lt;/script&gt;
&lt;/body&gt;

&lt;/html&gt;
</pre>
<p class="cap"><b>StudentApp.js</b></p><pre>/* ===========================================================================
   Web Development :: Graded Assignment (Weeks 1-6)  -  Question 2
   Field checks (onfocusout), an Applicant class, and cookie save/load.
   AMMAN JAKHAR  |  UID 2025eb01187

   Design notes:
     - Each checker returns true/false and writes a message beneath its field.
     - Name is tested character by character (letters + spaces only).
     - DOB is split on &quot;/&quot; and validated piece by piece, then age is derived.
     - Cookies use the max-age attribute and are read with Array.find().
   =========================================================================== */

&quot;use strict&quot;;

/* tiny helpers ------------------------------------------------------------- */
const el = (id) =&gt; document.getElementById(id);

// write (or clear) the red note under a field; returns true when there is no error
function note(field, text) {
  el(field + &quot;Error&quot;).textContent = text || &quot;&quot;;
  return !text;
}

/* 1. NAME :: letters and spaces only, not empty --------------------------- */
function checkName() {
  const value = el(&quot;name&quot;).value.trim();
  if (value.length === 0) {
    return note(&quot;name&quot;, &quot;Please enter your name.&quot;);
  }
  for (const ch of value) {
    const letter = (ch &gt;= &quot;a&quot; &amp;&amp; ch &lt;= &quot;z&quot;) || (ch &gt;= &quot;A&quot; &amp;&amp; ch &lt;= &quot;Z&quot;);
    if (!letter &amp;&amp; ch !== &quot; &quot;) {
      return note(&quot;name&quot;, &quot;Name may contain letters and spaces only.&quot;);
    }
  }
  return note(&quot;name&quot;, &quot;&quot;);
}

/* 2. DOB :: strict dd/mm/yyyy, not empty; also fills the age box ----------- */
function checkDob() {
  const value = el(&quot;dob&quot;).value.trim();
  el(&quot;age&quot;).value = &quot;&quot;;                       // reset age until DOB is valid

  if (value.length === 0) {
    return note(&quot;dob&quot;, &quot;Please enter your date of birth.&quot;);
  }

  const parts = value.split(&quot;/&quot;);
  const shaped =
    parts.length === 3 &amp;&amp;
    parts[0].length === 2 &amp;&amp;
    parts[1].length === 2 &amp;&amp;
    parts[2].length === 4 &amp;&amp;
    parts.every((p) =&gt; /^[0-9]+$/.test(p));

  if (!shaped) {
    return note(&quot;dob&quot;, &quot;Use the dd/mm/yyyy format, e.g. 29/08/1986.&quot;);
  }

  const day = Number(parts[0]);
  const month = Number(parts[1]);
  const year = Number(parts[2]);
  if (day &lt; 1 || day &gt; 31 || month &lt; 1 || month &gt; 12) {
    return note(&quot;dob&quot;, &quot;That is not a valid calendar date.&quot;);
  }

  el(&quot;age&quot;).value = ageFrom(day, month, year);
  return note(&quot;dob&quot;, &quot;&quot;);
}

/* AGE :: whole years between the DOB and today ---------------------------- */
function ageFrom(day, month, year) {
  const today = new Date();
  let years = today.getFullYear() - year;

  // step back a year if this year&#x27;s birthday has not arrived yet
  const todayMonth = today.getMonth() + 1;
  const beforeBirthday =
    todayMonth &lt; month || (todayMonth === month &amp;&amp; today.getDate() &lt; day);
  if (beforeBirthday) {
    years -= 1;
  }
  return years &gt;= 0 ? years : &quot;&quot;;
}

/* 3. MOBILE :: digits only, not empty, no leading zero -------------------- */
function checkMobile() {
  const box = el(&quot;mobile&quot;);
  const value = box.value.trim();

  const allDigits = value.length &gt; 0 &amp;&amp; [...value].every((c) =&gt; c &gt;= &quot;0&quot; &amp;&amp; c &lt;= &quot;9&quot;);
  if (!allDigits || value.charAt(0) === &quot;0&quot;) {
    box.value = &quot;&quot;;                           // rule: wipe the bad input
    return note(&quot;mobile&quot;, &quot;Enter digits only; not blank and not starting with 0.&quot;);
  }
  return note(&quot;mobile&quot;, &quot;&quot;);
}

/* 4. EMAIL :: has &quot;@&quot; (not first char) and ends in .com or .in ------------ */
function checkEmail() {
  const box = el(&quot;email&quot;);
  const value = box.value.trim();

  const atPos = value.indexOf(&quot;@&quot;);
  const goodTail = value.endsWith(&quot;.com&quot;) || value.endsWith(&quot;.in&quot;);
  if (atPos &lt; 1 || !goodTail) {
    box.value = &quot;&quot;;                           // rule: wipe the bad input
    return note(&quot;email&quot;, &#x27;Needs &quot;@&quot; (not at the start) and must end with .com or .in.&#x27;);
  }
  return note(&quot;email&quot;, &quot;&quot;);
}

/* -------------------------------------------------------------------------
   Applicant :: one object that carries the whole form
   ------------------------------------------------------------------------- */
class Applicant {
  constructor(name, dob, age, mobile, email) {
    this.name = name;
    this.dob = dob;
    this.age = age;
    this.mobile = mobile;
    this.email = email;
  }

  // single-line summary, handy for the console
  summary() {
    return [this.name, this.dob, &quot;age &quot; + this.age, this.mobile, this.email].join(&quot; | &quot;);
  }
}

/* -------------------------------------------------------------------------
   Cookie save / load  (max-age style; read via find())
   ------------------------------------------------------------------------- */
function saveCookie(key, value, days) {
  const seconds = days * 24 * 60 * 60;
  document.cookie =
    key + &quot;=&quot; + encodeURIComponent(value) + &quot;; max-age=&quot; + seconds + &quot;; path=/&quot;;
}

function loadCookie(key) {
  const prefix = key + &quot;=&quot;;
  const jar = document.cookie ? document.cookie.split(&quot;; &quot;) : [];
  const row = jar.find((item) =&gt; item.indexOf(prefix) === 0);
  return row ? decodeURIComponent(row.slice(prefix.length)) : null;
}

/* -------------------------------------------------------------------------
   Submit :: validate everything, build + log the object, store the cookie
   ------------------------------------------------------------------------- */
function onSubmit(event) {
  event.preventDefault();

  // run all four checks (keep them all so every message shows)
  const passed = [checkName(), checkDob(), checkMobile(), checkEmail()];
  if (passed.some((ok) =&gt; ok === false)) {
    alert(&quot;Please fix the fields marked in red, then submit again.&quot;);
    return false;
  }

  const applicant = new Applicant(
    el(&quot;name&quot;).value.trim(),
    el(&quot;dob&quot;).value.trim(),
    el(&quot;age&quot;).value.trim(),
    el(&quot;mobile&quot;).value.trim(),
    el(&quot;email&quot;).value.trim()
  );

  // requirement: show the object in the console
  console.log(&quot;Applicant created -&gt;&quot;, applicant);
  console.log(&quot;Applicant summary -&gt;&quot;, applicant.summary());

  // keep the record in a cookie for a week
  saveCookie(&quot;applicant&quot;, JSON.stringify(applicant), 7);

  // move to the retrieve panel
  el(&quot;formPage&quot;).style.display = &quot;none&quot;;
  el(&quot;retrievePage&quot;).style.display = &quot;block&quot;;
  return false;
}

/* -------------------------------------------------------------------------
   Retrieve :: match the typed mobile against the cookie and alert the data
   ------------------------------------------------------------------------- */
function onRetrieve() {
  const typed = el(&quot;retrieveMobile&quot;).value.trim();
  const stored = loadCookie(&quot;applicant&quot;);

  if (!stored) {
    alert(&quot;No application is stored in the cookie yet.&quot;);
    return;
  }

  const data = JSON.parse(stored);
  if (typed === data.mobile) {
    alert(
      &quot;Details fetched from the cookie\n\n&quot; +
      &quot;Name   : &quot; + data.name + &quot;\n&quot; +
      &quot;DOB    : &quot; + data.dob + &quot;\n&quot; +
      &quot;Age    : &quot; + data.age + &quot;\n&quot; +
      &quot;Mobile : &quot; + data.mobile + &quot;\n&quot; +
      &quot;Email  : &quot; + data.email
    );
  } else {
    alert(&quot;No stored record matches the mobile number &quot; + typed + &quot;.&quot;);
  }
}
</pre>
</body></html>