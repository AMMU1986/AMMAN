<p class="cap"><b>IDCard_styles.css</b></p><pre>/* ---------------------------------------------------------------------------
   Web Development :: Graded Assignment (Weeks 1-6)  -  Question 1
   Stylesheet for the Student Identity Card
   AMMAN JAKHAR  |  UID 2025eb01187

   Selector mix used below:
     * type selectors ...... body, dt, dd, figcaption
     * class selectors ..... .badge, .badge__facts, .badge__top ...
     * pseudo-class ........ dd:last-of-type
     * descendant combos ... .badge__facts dt
   Layout uses CSS Grid for the label/value pairs; a palette of charcoal + amber.
--------------------------------------------------------------------------- */

:root {
  --ink: #13343b;
  --ink-soft: #4a6168;
  --amber: #e0a800;
  --line: #d7dedc;
  --paper: #ffffff;
}

/* page canvas */
body {
  margin: 0;
  min-height: 100vh;
  padding: 46px 16px;
  font-family: &quot;Trebuchet MS&quot;, &quot;Segoe UI&quot;, system-ui, sans-serif;
  color: var(--ink);
  background: radial-gradient(circle at top, #f2f6f5, #d8e4e2);
  display: grid;
  place-items: start center;
}

/* the card itself */
.badge {
  width: 430px;
  max-width: 100%;
  background: var(--paper);
  border: 1px solid var(--line);
  border-radius: 14px;
  box-shadow: 0 14px 30px rgba(19, 52, 59, 0.28);
  overflow: hidden;
}

/* ---- top strip ---- */
.badge__top {
  padding: 18px 20px 14px;
  text-align: center;
  color: var(--paper);
  background: var(--ink);
  border-bottom: 5px solid var(--amber);
}

.badge__org {
  margin: 0;
  font-size: 24px;
  font-weight: 700;
  letter-spacing: 2px;
}

.badge__kind {
  margin: 4px 0 0;
  font-size: 12px;
  letter-spacing: 4px;
  text-transform: uppercase;
  color: var(--amber);
}

/* ---- middle ---- */
.badge__main {
  display: grid;
  grid-template-columns: 120px 1fr;
  gap: 18px;
  padding: 22px 20px;
}

/* photo column */
.badge__photo {
  margin: 0;
  text-align: center;
}

.badge__photo-box {
  display: grid;
  place-items: center;
  width: 110px;
  height: 132px;
  color: var(--ink-soft);
  font-weight: 700;
  letter-spacing: 1px;
  background: repeating-linear-gradient(45deg, #f3f6f5, #f3f6f5 8px, #eaf0ef 8px, #eaf0ef 16px);
  border: 2px solid var(--ink);
  border-radius: 6px;
}

.badge__photo figcaption {
  margin-top: 6px;
  font-size: 10px;
  letter-spacing: 1px;
  text-transform: uppercase;
  color: var(--ink-soft);
}

/* facts column: two-column grid, label then value */
.badge__facts {
  display: grid;
  grid-template-columns: max-content 1fr;
  column-gap: 12px;
  row-gap: 0;
  margin: 0;
  align-content: start;
}

.badge__facts dt {
  padding: 7px 0 2px;
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 0.6px;
  text-transform: uppercase;
  color: var(--amber);
  grid-column: 1 / -1;      /* label sits on its own line */
}

.badge__facts dd {
  margin: 0 0 7px;
  padding-bottom: 7px;
  font-size: 14px;
  color: var(--ink);
  border-bottom: 1px dotted var(--line);
  grid-column: 1 / -1;      /* value spans full width under the label */
  word-break: break-word;
}

.badge__facts dd:last-of-type {
  border-bottom: none;
}

/* ---- bottom strip ---- */
.badge__bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 11px 20px;
  font-size: 12px;
  background: #f4f7f6;
  border-top: 2px solid var(--ink);
}

.badge__uid {
  font-weight: 700;
  color: var(--ink);
}

.badge__sign {
  font-style: italic;
  color: var(--ink-soft);
}

/* ---- small screens: stack photo above the facts ---- */
@media (max-width: 460px) {
  .badge__main {
    grid-template-columns: 1fr;
    justify-items: center;
    text-align: center;
  }

  .badge__facts {
    justify-items: start;
    text-align: left;
    width: 100%;
  }

  .badge__org {
    font-size: 20px;
  }
}
</pre>
